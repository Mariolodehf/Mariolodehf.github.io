<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{% if title %}{{ title }} | Blog | Mario De Hoyos F{% else %}Blog | Mario De Hoyos F{% endif %}</title>
  <meta name="description" content="{% if summary %}{{ summary | safe }}{% else %}Articles and experiences by Mario De Hoyos in telecommunications and cybersecurity.{% endif %}" />
  <link rel="canonical" href="https://mariolodehf.github.io/blog{{ page.url }}" />
  <meta name="color-scheme" content="dark light" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap" />
  <link rel="stylesheet" href="/css/styles.css" />
  <script>
    (function(){
      try {
        const stored = localStorage.getItem('theme');
        const preferred = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', preferred);
      } catch(e) {}
    })();
  </script>
  {# Open Graph & JSON-LD solo para posts con front matter #}
  {% if '/posts/' in page.filePathStem %}
    {% set ogTitle = title + ' | Blog | Mario De Hoyos F' %}
    {% set ogDesc = summary or site.description %}
    {% if cover %}<meta property="og:image" content="https://mariolodehf.github.io{{ cover }}" />{% endif %}
    <meta property="og:type" content="article" />
    <meta property="og:title" content="{{ ogTitle }}" />
    <meta property="og:description" content="{{ ogDesc }}" />
  <meta property="og:url" content="https://mariolodehf.github.io/blog{{ page.url }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ ogTitle }}" />
    <meta name="twitter:description" content="{{ ogDesc }}" />
    {% if cover %}<meta name="twitter:image" content="https://mariolodehf.github.io{{ cover }}" />{% endif %}
    <script type="application/ld+json">{
      "@context": "https://schema.org",
      "@type": "Article",
  "mainEntityOfPage": {"@type":"WebPage","@id":"https://mariolodehf.github.io/blog{{ page.url }}"},
      "headline": {{ ogTitle | dump }},
      {% if cover %}"image": ["https://mariolodehf.github.io{{ cover }}"],{% endif %}
      "datePublished": "{{ page.date | date('%Y-%m-%d') }}",
      "dateModified": "{{ page.date | date('%Y-%m-%d') }}",
      "author": {"@type":"Person","name":"Mario De Hoyos F"},
      "publisher": {"@type":"Person","name":"Mario De Hoyos F"},
      "description": {{ ogDesc | dump }}
    }</script>
  {% endif %}
</head>
<body class="blog-body">
  <header class="site-header">
    <nav class="nav" aria-label="Principal">
      <a class="logo" href="/"><span class="logo__dot" aria-hidden="true"></span>Mario de Hoyos</a>
      <div class="nav__actions">
        <button id="theme-toggle" class="btn-icon" type="button" aria-pressed="false" aria-label="Cambiar tema"><span class="theme-icon" aria-hidden="true"></span></button>
        <button class="nav__toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Abrir menú" type="button">
          <span class="nav__toggle-bar" aria-hidden="true"></span>
        </button>
      </div>
      <ul id="nav-menu" class="nav__menu">
        <li><a href="/">Red</a></li>
        <li><a href="/#proyectos">Proyectos</a></li>
        <li><a href="/#formacion">Formación</a></li>
        <li><a href="/blog/">Blog</a></li>
      </ul>
    </nav>
  </header>
  <div class="nav__overlay" data-nav-overlay hidden></div>
  <main class="main">
    <div class="prose">
  {% if '/posts/' in page.filePathStem %}
        <h1 class="post-title">{{ title }}</h1>
        <p class="post-meta">
          Publicado el {{ page.date | date('%Y-%m-%d') }} · {{ content | readTime }} min de lectura
        </p>
      {% endif %}
      {{ content | safe }}
    </div>
  </main>
  <footer class="site-footer">
    <p>&copy; <span id="year"></span> Mario de Hoyos · Medellín, Colombia</p>
    <p class="mono">Hecho a mano, con hifas y paquetes.</p>
  </footer>
  <script src="/js/main.js" defer></script>
</body>
</html>
