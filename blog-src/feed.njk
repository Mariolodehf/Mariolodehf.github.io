---
permalink: /feed.xml
eleventyExcludeFromCollections: true
layout: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ i18n.es.siteTitle }}</title>
    <link>{{ site.url }}/blog/</link>
    <description>{{ i18n.es.description }}</description>
    <language>es</language>
    <atom:link href="{{ site.url }}/blog/feed.xml" rel="self" type="application/rss+xml" />
    {%- for post in collections.post | reverse %}
    <item>
      <title>{{ post.data.title | xmlEscape }}</title>
      <link>{{ site.url }}/blog{{ post.url }}</link>
      <guid>{{ site.url }}/blog{{ post.url }}</guid>
      <pubDate>{{ post.date | dateRFC822 }}</pubDate>
      {% if post.data.summary %}<description>{{ post.data.summary | xmlEscape }}</description>{% endif %}
    </item>
    {%- endfor %}
  </channel>
</rss>
